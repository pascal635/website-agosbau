# AGOS BAU — Apache-Konfig (Hetzner Webhosting)

# Kanonische URL erzwingen: HTTPS + ohne www.
# Verhindert Duplicate Content (Seite war unter 4 URL-Varianten mit Status 200 erreichbar).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS. Beide Bedingungen müssen zutreffen (AND), damit hinter
  # einem TLS-Proxy keine Redirect-Schleife entsteht.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://agosbau.de%{REQUEST_URI} [L,R=301]

  # www.agosbau.de -> agosbau.de
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://agosbau.de%{REQUEST_URI} [L,R=301]
</IfModule>

# Zeichensatz im HTTP-Header (Seobility: „Es fehlen Zeichensatzangaben im HTTP Header")
AddDefaultCharset UTF-8

# 301-Redirects: alte WordPress-URLs → neue Struktur (absolut, spart einen Hop)
Redirect 301 /leistungen/ https://agosbau.de/fliesenverlegung-bremen/
Redirect 301 /fliesenleger-kosten/ https://agosbau.de/badsanierung-bremen/

# Eigene 404-Seite
ErrorDocument 404 /404.html

# Security-Header (behebt Seobility „Server-Konfiguration")
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header unset X-Powered-By
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Caching: gehashte Assets lange, HTML kurz
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
